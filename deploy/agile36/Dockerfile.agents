# Agile36 agent runner: buzz-acp + Claude Code (via ACP adapter) in one image.
# One container of this image = one team member. Persona comes from a mounted
# prompt file; identity comes from BUZZ_PRIVATE_KEY in the environment.

# --- Stage 1: build the Buzz binaries we need -------------------------------
FROM rust:1.95-bookworm AS builder
WORKDIR /src
COPY . .
# buzz-acp  — the harness that listens for @mentions and drives the agent
# buzz-admin — key generation / member registration (used by setup, kept for ops)
# buzz       — the Buzz CLI the agent uses to reply, create channels, etc.
RUN cargo build --release -p buzz-acp -p buzz-admin -p buzz-cli

# --- Stage 2: runtime -------------------------------------------------------
FROM node:24-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl ripgrep \
 && rm -rf /var/lib/apt/lists/*

# Claude Code + its ACP adapter. The adapter speaks ACP over stdio to buzz-acp
# and runs the Claude Agent SDK underneath.
RUN npm install -g @anthropic-ai/claude-code @agentclientprotocol/claude-agent-acp \
    @openai/codex @agentclientprotocol/codex-acp

COPY --from=builder /src/target/release/buzz-acp /usr/local/bin/
COPY --from=builder /src/target/release/buzz-admin /usr/local/bin/
COPY --from=builder /src/target/release/buzz /usr/local/bin/

# Non-root user; agents get a real home so Claude can keep per-agent state.
RUN useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent

ENV BUZZ_ACP_AGENT_COMMAND=claude-agent-acp
ENTRYPOINT ["buzz-acp"]
